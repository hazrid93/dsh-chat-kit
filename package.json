{
  "name": "dsh-chat-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Platform-neutral chat runtime on DeepSeek Harness: one turn engine, per-chat DSH sessions, live progress pages, pluggable adapters.",
  "exports": {
    ".": "./packages/core/src/chat-runtime.js",
    "./store": "./packages/core/src/mirror-store.js",
    "./client": "./packages/core/src/dsh-client.js",
    "./routes": "./packages/core/src/mirror-routes.js",
    "./mirror-client.js": "./packages/core/public/mirror-client.js",
    "./adapter.js": "./packages/core/src/adapter.js",
    "./attachments.js": "./packages/core/src/attachments.js",
    "./publish.js": "./packages/core/src/publish-site.mjs",
    "./adapters/discord": "./adapters/discord/index.js"
  },
  "scripts": {
    "test": "node --test",
    "example": "node examples/echo/bot.mjs"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "license": "MIT",
  "optionalDependencies": {
    "pg": "^8.16.3"
  },
  "peerDependencies": {
    "discord.js": "^14"
  },
  "peerDependenciesMeta": {
    "discord.js": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hazrid93/dsh-chat-kit.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "chatbot",
    "whatsapp",
    "discord",
    "agent"
  ],
  "engines": {
    "node": ">=20"
  }
}