# DSH runtime
DSH_BIN=/home/ubuntu/.nvm/versions/node/v24.18.0/bin/dsh
DSH_PROFILE=whatsapp
DSH_HOME_DIR=/srv/dsh-home
WORKSPACE_DIR=/srv/dsh-workspace
DSH_PROVIDER=litellm
DSH_MODEL=deepseek-v4.1-flash
DSH_EFFORT=high

# Progress pages
PUBLIC_BASE_URL=https://example.com

# Site publishing (optional)
SITE_PUBLIC_ROOT=/home/ubuntu/ephemeral-sites
SITE_PUBLISH_SUDO=1

# Postgres for mirrors (optional; memory-only without it)
DATABASE_URL=
